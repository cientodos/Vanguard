--- !u!114 &1786839020
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1786839018}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 20
    m_FontStyle: 1
    m_BestFit: 0
    m_MinSize: 2
    m_MaxSize: 40
    m_Alignment: 4
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\u3010\uB4DC\uB798\uADF8\uB4DC\uB808\uC2A4\u3011 - \u3010\uC790\uB3D9\u3011\u3010\uBC45\uAC00\uB4DC
    \uC11C\uD074\u3011 : \uC774 \uC720\uB2DB\uC774 \uC5B4\uD0DD \uD55C \uBC30\uD2C0
    \uC885\uB8CC \uC2DC, \uB2F9\uC2E0\uC758 \uD328\uC5D0\uC11C \u300C\uB4DC\uB798\uADF8\uD3FC\u300D\uC744
    \uD3EC\uD568\uD558\uB294 \uCE74\uB4DC\uB97C 1\uC7A5\uAE4C\uC9C0 \uC120\uD0DD\uD558\uACE0,
    \u3010\uC2A4\uD0E0\uB4DC\u3011\uB85C \uB77C\uC774\uB4DC\uD558\uACE0, \uADF8 \uD134
    \uC911, \uB4DC\uB77C\uC774\uBE0C-2. \uB77C\uC774\uB4DC \uD588\uB2E4\uBA74, \uADF8
    \uD134 \uC885\uB8CC \uC2DC, \uB2F9\uC2E0\uC758 \uC18C\uC6B8\uC5D0\uC11C \u300C\uC720\uC2A4\uBCA0\uB974\uD06C
    \"\uB4DC\uB798\uADF8\uD3EC\uC2A4 \uC554\uC988 \uD658\uC601\"\u300D\uC744 1\uC7A5
    \uC120\uD0DD\uD558\uACE0, \u3010\uB808\uC2A4\uD2B8\u3011\uB85C \uB77C\uC774\uB4DC\uD55C\uB2E4.\r\n\u3010\uAE30\uB3D9\u3011\u3010\uBC45\uAC00\uB4DC
    \uC11C\uD074\u3011\u3010\uD1341\uD68C\u3011 : \u3010\uCF54\uC2A4\uD2B8\u3011[\uD328\uC5D0\uC11C
    1\uC7A5 \uBC84\uB9BC]\uC73C\uB85C, \uB2F9\uC2E0\uC758 \uB371\uC744 \uC704\uC5D0\uC11C
    3\uC7A5 \uBCF4\uACE0, \uADF8 \uC911\uC5D0\uC11C, \u300C\uB4DC\uB798\uADF8\uD3FC\u300D\uC744
    \uD3EC\uD568\uD558\uB294 \uCE74\uB4DC \uB610\uB294, \uADF8\uB808\uC774\uB4DC
    2 \uC774\uD558\uB97C 1\uC7A5\uAE4C\uC9C0 \uC120\uD0DD\uD558\uC5EC, \uACF5\uAC1C\uD558\uACE0,
    \u300C\uB4DC\uB798\uADF8\uD3FC\u300D\uC744 \uD3EC\uD568\uD558\uB294 \uCE74\uB4DC\uB77C\uBA74
    \uD328\uC5D0 \uCD94\uAC00\uD558\uACE0, \uC544\uB2C8\uB77C\uBA74 \uB9AC\uC5B4\uAC00\uB4DC
    \uC11C\uD074\uC5D0 \uCF5C \uD55C\uB2E4. \uB098\uBA38\uC9C0 \uC804\uBD80\uB97C
    \uBC84\uB824\uB3C4 \uB41C\uB2E4. \uBC84\uB9AC\uC9C0 \uC54A\uC558\uB2E4\uBA74,
    \uADF8\uAC83\uB4E4\uC744 \uB371 \uC544\uB798\uC5D0 \uC6D0\uD558\uB294 \uC21C\uC11C\uB300\uB85C
    \uB193\uB294\uB2E4.\r\n\u3010\uC790\uB3D9\u3011\u3010\uBC45\uAC00\uB4DC \uC11C\uD074\u3011:
    \uB2F9\uC2E0\uC758 \uBA54\uC778 \uD398\uC774\uC988 \uAC1C\uC2DC \uC2DC, \uADF8
    \uD134 \uC911, \uB2F9\uC2E0\uC740 \u300E\uB2F9\uC2E0\uC758 \uBC45\uAC00\uB4DC\uAC00
    \uC5B4\uD0DD \uD588\uC744 \uB54C, \uC885\uC871\uC5D0 \u3008\uB4DC\uB798\uACE4\u3009\uC744
    \uD3EC\uD568\uD558\uB294 \uB2F9\uC2E0\uC758 \uB4DC\uB86D 1\uC7A5\uB2F9, \uADF8
    \uBC30\uD2C0 \uC911, \uADF8 \uC720\uB2DB\uC758 \uD30C\uC6CC+1000.\u300F\uC744
    \uC5BB\uB294\uB2E4."
