--- !u!114 &1171687707
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1171687702}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 07128e0d3ba083e4c97843374c57b2e6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  currentState: 0
  cardName: "X-CeeDaNCe \uC778\uBC1C\uB514\uC624 \"\uD658\uC601\""
  effectText: "\uAE30\uB3D9\u3011\u3010\uBC45\uAC00\uB4DC \uC11C\uD074\u3011\u3010\uD1341\uD68C\u3011
    : \u3010\uCF54\uC2A4\uD2B8\u3011[\u3010\uCE74\uC6B4\uD130 \uBE14\uB798\uC2A4\uD2B8\u3011(1)]\uD558\uB294
    \uAC83\uC73C\uB85C, \uB2F9\uC2E0\uC758 \uB4DC\uB86D\uC5D0\uC11C 1\uC7A5 \uC120\uD0DD\uD558\uACE0,
    \uB2F9\uC2E0\uC758 \uC790\uAE30\uAC1C\uC218 \uAC8C\uC774\uC9C0\uB85C\uC11C \uC55E\uBA74\uC73C\uB85C
    \uB193\uACE0, X-ceed NET \uB9C8\uCEE4\uAC00 \uC5C6\uB294 \uB2F9\uC2E0\uC758 \uB9AC\uC5B4\uAC00\uB4DC
    \uC11C\uD074\uC744 1\uAC1C \uC120\uD0DD\uD558\uACE0, X-ceed NET \uB9C8\uCEE4\uB97C
    1\uAC1C \uB193\uB294\uB2E4. \u3010\uD32C\uD140 \uC2A4\uD0AC\u3011\u3010\uAE30\uB3D9\u3011\u3010\uBC45\uAC00\uB4DC
    \uC11C\uD074\u3011\u3010\uD1341\uD68C\u3011 : \u3010\uCF54\uC2A4\uD2B8\u3011[\uD328\uB098
    \uC18C\uC6B8\uC774\uB098 \uB4DC\uB86D\uC5D0\uC11C \uD601\uC6D4 \uCE74\uB4DC\uB97C
    \uD569\uACC4 1\uC7A5\uC774\uC0C1, \uC6D0\uD558\uB294 \uB9E4\uC218 \uBC14\uC778\uB4DC\uD568]\uC73C\uB85C,
    \uB2F9\uC2E0 \uBC14\uC778\uB4DC\uC874\uC758 \uD601\uC6D4 \uCE74\uB4DC 1\uAC1C\uB2F9,
    \uC774\uD558\uB97C 1\uAC1C \uC2E4\uC2DC\uD55C\uB2E4. (\uAC19\uC740 \uAC78 \uC120\uD0DD\uD560
    \uC218 \uC5C6\uB2E4.) \xB7 \uADF8 \uD134 \uC911, \uC774 \uC720\uB2DB\uC758 \uB4DC\uB77C\uC774\uBE0C+1.
    \xB7 \uADF8 \uD134 \uC911, \uC774 \uC720\uB2DB\uC758 \uD06C\uB9AC\uD2F0\uCEEC+1.
    \xB7 \uB2E4\uC74C \uC0C1\uB300\uC758 \uD134 \uC885\uB8CC\uC2DC\uAE4C\uC9C0, \uB2F9\uC2E0
    \uB9AC\uC5B4\uAC00\uB4DC\uB294 X-ceed NET \uB9C8\uCEE4\uAC00 \uC788\uB294 \uC911\uC559\uB4B7\uC5F4\uC5D0\uC11C\uB3C4
    \uC5B4\uD0DD\uACFC \uC778\uD130\uC149\uD2B8\uD560 \uC218 \uC788\uB2E4. \u300E\uB2A5\uAC00\uD558\uACA0\uC0AC\uC640\uC694.
    \uB2E4\uC218\uC758 \uBCC4\uB4E4, \uADF8 \uBAA8\uB450\uB97C!\u300F"
  tribe: "\uD734\uBA3C/\uD658\uC601"
  flavorText: "\uB2A5\uAC00\uD558\uACA0\uC0AC\uC640\uC694. \uB2E4\uC218\uC758 \uBCC4\uB4E4,
    \uADF8 \uBAA8\uB450\uB97C!"
  grade: 3
  power: 13000
  shiled: 0
  crit: 1
  countary: "\uB9AC\uB9AC\uCEEC\uBAA8\uB098\uC2A4\uD14C\uB9AC\uC624"
  trigger: 0
