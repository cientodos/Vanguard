  - id: 63000148
    cardName: "\uC774\uBBF8\uC9C0\uD574\uB77C! \uB9C8\uB9B4\uB80C\uACFC\uC758 \uD32C\uBBF8\uD305\uC744!
      \uB2E4\uC6B0\uB108\uB204\uB098"
    grade: 3
    power: 13000
    shield: 0
    critical: 1
    maxCount: 4
    isSentinel: 0
    countryList: 05000000
    tribeList: 01000000
    triggerType: 0
    cardType: 0
    flavorText: "\u300E\uC798 \uB4E4\uC5B4\uB77C \uC18C\uB144, \uC774\uBBF8\uC9C0\uD574\uB77C.
      \uC774\uBBF8\uC9C0\uB294 \uB108\uC758 \uD798\uC774 \uB41C\uB2E4.\u300F"
    effectText: "\u3010\uC601\uC18D\u3011\u3010\uBC45\uAC00\uB4DC \uC11C\uD074 /
      \uB371 / \uC18C\uC6B8\u3011 : \uC774 \uCE74\uB4DC\uB294 \u300C\uB7EC\uBE0C\uCF5C
      \uB9C8\uB9B4\uB80C\u300D\uC73C\uB85C\uB3C4 \uCDE8\uAE09\uD55C\uB2E4.\n\u3010\uC790\uB3D9\u3011\u3010\uD328\u3011
      : \uB2F9\uC2E0 \uBC45\uAC00\uB4DC \uC11C\uD074\uC758 \u300C\uB7EC\uBE0C\uCF5C
      \uB9C8\uB9B4\uB80C\u300D\uC774 \uC5B4\uD0DD\uD55C \uBC30\uD2C0 \uC885\uB8CC\uC2DC,
      \u3010\uCF54\uC2A4\uD2B8\u3011[\u3010\uC18C\uC6B8 \uBE14\uB798\uC2A4\uD2B8\u3011(2)]\uD558\uB294
      \uAC83\uC73C\uB85C, \uC774 \uCE74\uB4DC\uB97C \u3010\uC2A4\uD0E0\uB4DC\u3011\uB85C
      \uB77C\uC774\uB4DC\uD558\uACE0, \uADF8 \uD134 \uC911, \uB4DC\uB77C\uC774\uBE0C-1\uD558\uACE0,
      \uB2F9\uC2E0\uC740 \uD328\uC5D0\uC11C \uB77C\uC774\uB4DC\uD560 \uC218 \uC5C6\uB2E4.
      \uADF8 \uD134 \uC885\uB8CC\uC2DC, \uB2F9\uC2E0\uC758 \uC18C\uC6B8\uC5D0\uC11C
      \u300C\uB7EC\uBE0C\uCF5C \uB9C8\uB9B4\uB80C\u300D\uC744 1\uC7A5 \uC120\uD0DD\uD558\uACE0,
      \u3010\uB808\uC2A4\uD2B8\u3011\uB85C \uB77C\uC774\uB4DC\uD55C\uB2E4.\n\u3010\uAE30\uB3D9\u3011\u3010\uC18C\uC6B8\u3011
      : \uB2F9\uC2E0\uC758 \uBC45\uAC00\uB4DC\uAC00 \u300C\uB9C8\uB9B4\uB80C\u300D\uC744
      \uD3EC\uD568\uD55C \uADF8\uB808\uC774\uB4DC 3 \uC774\uC0C1\uC774\uBA70, \uC774
      \uD134\uC5D0 \uC774 \uCE74\uB4DC\uC640 \uAC19\uC740 \uC774\uB984\uC778 \uB2F9\uC2E0\uC758
      \uCE74\uB4DC\uAC00 \uBC14\uC778\uB4DC\uB418\uC9C0 \uC54A\uC558\uB2E4\uBA74,
      \u3010\uCF54\uC2A4\uD2B8\u3011[\uC774 \uCE74\uB4DC\uB97C \uBC14\uC778\uB4DC\uD568]\uC73C\uB85C,
      \uADF8 \uD134 \uC911, \uB2F9\uC2E0\uC740 \u300E\uB2F9\uC2E0 \uC55E\uC5F4 \uC720\uB2DB
      \uC804\uBD80\uC758 \uD30C\uC6CC+5000.\u300F\uC744 \uC5BB\uB294\uB2E4. \uC774
      \uD134\uC5D0 \uB2F9\uC2E0\uC774 \uD398\uB974\uC18C\uB098 \uB77C\uC774\uB4DC\uD588\uB2E4\uBA74,
      \u3010\uCE74\uC6B4\uD130 \uCC28\uC9C0\u3011(1)\uC774\uB098 \u3010\uC5D0\uB108\uC9C0
      \uCC28\uC9C0\u3011(3)."
    availableRarities: 00000000
    spriteAssetKeys:
    - card_63000148
