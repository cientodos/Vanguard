    effectText: "\uB4DC\uB808\uC2A4\uC5C5 - \u300C\uADF8\uB9AC\uBAA8 \uC5D0\uD22C\uC54C
      \uB8E8\uD14C\uC2DC\uC544\u300D (\uD30C\uC774\uD2B8 \uC911, \uC9C0\uC815 \uCE74\uB4DC\uC640
      \uAC19\uC740 \uC774\uB984\uC73C\uB85C\uB3C4 \uCDE8\uAE09\uD55C\uB2E4)\r\n\u3010\uC601\uC18D\u3011
      : \uC774 \uCE74\uB4DC\uB294 \u300C\uB8E8\uD14C\uC2DC\uC544\u300D\uB97C \uD3EC\uD568\uD55C
      \uADF8\uB808\uC774\uB4DC 3\uC5D0\uC11C\uB9CC \uB77C\uC774\uB4DC\uD560 \uC218
      \uC788\uB2E4.\r\n\u3010\uC790\uB3D9\u3011 \uC774 \uC720\uB2DB\uC774 \uBC45\uAC00\uB4DC
      \uC11C\uD074\uC5D0 \uB4F1\uC7A5\uD588\uC744 \uB54C, \uC790\uC2E0\uC758, \uB371\uC774\uB098
      \uB4DC\uB86D\uC5D0\uC11C \uC8FC\uC220 \uC5F0\uCD9C \uCE74\uB4DC\uB97C 1\uC7A5\uAE4C\uC9C0
      \uCC3E\uACE0, \uACF5\uAC1C\uD558\uC5EC \uD328\uC5D0 \uCD94\uAC00\uD558\uACE0,
      \uB371\uC5D0\uC11C \uCC3E\uC558\uB2E4\uBA74, \uB371\uC744 \uC154\uD50C\uD55C\uB2E4.\r\n\u3010\uAE30\uB3D9\u3011\u3010\uBC45\uAC00\uB4DC
      \uC11C\uD074\u3011\u3010\uD1341\uD68C\u3011 : \u3010\uCF54\uC2A4\uD2B8\u3011[\u3010\uCE74\uC6B4\uD130
      \uBE14\uB798\uC2A4\uD2B8\u3011(1)]\uD558\uB294 \uAC83\uC73C\uB85C, \uC790\uC2E0
      \uC18C\uC6B8\uC758 \uC8FC\uC220 \uC5F0\uCD9C \uCE74\uB4DC \uB9E4\uC218\uC5D0
      \uB530\uB77C, \uADF8 \uD134 \uC911, \uC774 \uC720\uB2DB\uC740 \uC774\uD558
      \uC804\uBD80\uB97C \uC5BB\uB294\uB2E4.\r\n\xB7 2\uC7A5\uC774\uC0C1 - \u3010\uC601\uC18D\u3011\u3010\uBC45\uAC00\uB4DC
