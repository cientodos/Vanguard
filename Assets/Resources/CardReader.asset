    tribeList: 0500000009000000
    triggerType: 0
    cardType: 0
    flavorText: "\u300E\uB3D9\uACBD\uD558\uB358 \uC7A5\uC18C. \uADF8 \uC55E\uC5D0
      \uBE5B\uB098\uB294 \uD48D\uACBD\uC744, \uBAA8\uB450\uC640 \uD568\uAED8.\u300F"
    effectText: "\u3010\uAE30\uB3D9\u3011\u3010\uBC45\uAC00\uB4DC \uC11C\uD074\u3011\u3010\uD1341\uD68C\u3011
      : \u3010\uCF54\uC2A4\uD2B8\u3011[\u3010\uC18C\uC6B8 \uBE14\uB798\uC2A4\uD2B8\u3011(1)]\uD558\uB294
      \uAC83\uC73C\uB85C, \uB2F9\uC2E0\uC758 \uB9AC\uC5B4\uAC00\uB4DC\uB97C 2\uC7A5\uAE4C\uC9C0
      \uC120\uD0DD\uD558\uACE0, \uADF8 \uD134 \uC911, \uADF8 \uC720\uB2DB\uC740 \uB4B7\uC5F4\uC5D0\uC11C\uB3C4
      \uC5B4\uD0DD\uD560 \uC218 \uC788\uB2E4. \uC0C1\uB300\uC758 \uBC45\uAC00\uB4DC\uAC00
      \uADF8\uB808\uC774\uB4DC 3 \uC774\uC0C1\uC774\uB77C\uBA74, \uB2E4\uC2DC \u3010\uCF54\uC2A4\uD2B8\u3011[\u3010\uCE74\uC6B4\uD130
      \uBE14\uB798\uC2A4\uD2B8\u3011(1)]\uD558\uB294 \uAC83\uC73C\uB85C, \uADF8 \uD134
      \uC911, \uB2F9\uC2E0 \uB4B7\uC5F4 \uB9AC\uC5B4\uAC00\uB4DC \uC804\uBD80\uC758
      \uD30C\uC6CC+10000\uD558\uACE0, \uB2E4\uC74C \uC0C1\uB300\uC758 \uD134 \uC885\uB8CC\uC2DC\uAE4C\uC9C0,
      \uC774 \uC720\uB2DB\uC758 \uADF8\uB808\uC774\uB4DC+1/\uB4DC\uB77C\uC774\uBE0C+1.\n\u3010\uD32C\uD140
      \uC2A4\uD0AC\u3011\u3010\uC790\uB3D9\u3011\u3010\uBC45\uAC00\uB4DC \uC11C\uD074\u3011
      : \uB2F9\uC2E0\uC758 \uD134 \uC885\uB8CC\uC2DC, \u3010\uCF54\uC2A4\uD2B8\u3011[\uD328\uB098
      \uC18C\uC6B8\uC774\uB098 \uB4DC\uB86D\uC5D0\uC11C, \uD601\uC6D4 \uCE74\uB4DC\uB97C
      \uD569\uACC4 1\uC7A5\uC774\uC0C1, 2\uC7A5\uAE4C\uC9C0 \uBC14\uC778\uB4DC\uD568]\uC73C\uB85C,
      \uC218\uD638\uC790\uB97C \uAC16\uACE0 \uC788\uC9C0 \uC54A\uC740 \uB2F9\uC2E0\uC758
      \uB9AC\uC5B4\uAC00\uB4DC\uB97C, \uC774 \uCF54\uC2A4\uD2B8\uB85C \uBC14\uC778\uB4DC\uB41C
      \uCE74\uB4DC\uC640 \uAC19\uC740 \uB9E4\uC218\uAE4C\uC9C0 \uC120\uD0DD\uD558\uACE0,
      \uD328\uC5D0 \uB418\uB3CC\uB9B0\uB2E4. \uB2E4\uC74C \uC0C1\uB300\uC758 \uD134
      \uC885\uB8CC\uC2DC\uAE4C\uC9C0, \uC774 \uC720\uB2DB\uC740 \u300E\u3010\uC601\uC18D\u3011\u3010\uBC45\uAC00\uB4DC
      \uC11C\uD074\u3011 : \u300CLettiaMateS\u300D\uB97C \uD3EC\uD568\uD55C \uB2F9\uC2E0
      \uC720\uB2DB \uC804\uBD80\uC758 \uC2E4\uB4DC+5000.\u300F \uC744 1\uAC1C \uC5BB\uB294\uB2E4.
      \uC774 \uCF54\uC2A4\uD2B8\uB85C 2\uC7A5 \uBC14\uC778\uB4DC\uB410\uB2E4\uBA74,
      1\uAC1C\uAC00 \uC544\uB2CC 2\uAC1C \uC5BB\uB294\uB2E4."
