      \uC774 \uC720\uB2DB\uC758 \uD30C\uC6CC+15000.\r\n\xB7 \u300C\uC5D0\uBC84\uB77C\uC2A4\uD305
      \uC0AC\uD30C\uC774\uC5B4\u300D - \u3010\uCF54\uC2A4\uD2B8\u3011[\u3010\uCE74\uC6B4\uD130
      \uBE14\uB798\uC2A4\uD2B8\u3011(1), \uC911\uC559\uB4B7\uC5F4\uC758 \uB9AC\uC5B4\uAC00\uB4DC\uB97C
      1\uC7A5 \uB371 \uC544\uB798\uC5D0 \uB193\uC74C] \uC73C\uB85C, \uC774 \uC720\uB2DB\uC744
