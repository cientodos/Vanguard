  - id: 63000116
    cardName: "FL\u2200MMe-G \uB85C\uC9C0\uC544"
    grade: 3
    power: 13000
    shield: 0
    critical: 1
    maxCount: 4
    isSentinel: 0
    countryList: 05000000
    tribeList: 01000000
    triggerType: 0
    cardType: 0
    flavorText: "\u300E\uC9C0\uC625\uC758 \uD5C8\uD48D\uC5D0 \uB9E4\uB8CC\uB418\uC5B4
      \uCDA4\uCDB0\uB77C! \uB2E4\uC74C \uACE1\uC740! \uC8FD\uC74C\uC758 \uBB34\uB3C4!\r\n(\uC774\uAC70,
      \uC81C\uAC00 \uC0DD\uAC01\uD55C \uC544\uC774\uB3CC\uACFC \uBB54\uAC00 \uB2E4\uB978
      \uAC83 \uAC19\uC544\uC694\uC624!)\u300F"
    effectText: "\u3010\uAE30\uB3D9\u3011\u3010\uBC45\uAC00\uB4DC \uC11C\uD074\u3011\u3010\uD1341\uD68C\u3011
      : \u3010\uCF54\uC2A4\uD2B8\u3011[\u3010\uC18C\uC6B8 \uBE14\uB798\uC2A4\uD2B8\u3011(1)]\uD558\uB294
      \uAC83\uC73C\uB85C, \uB371\uC774\uB098 \uC18C\uC6B8\uC5D0\uC11C \u300CFL\u2200MMe-G\u300D\uB97C
      \uD3EC\uD568\uD55C \uADF8\uB808\uC774\uB4DC 2 \uC774\uD558\uB97C 1\uC7A5\uAE4C\uC9C0
      \uCC3E\uACE0, \uB9AC\uC5B4\uAC00\uB4DC \uC11C\uD074\uC5D0 \uCF5C\uD558\uACE0,
      \uB371\uC5D0\uC11C \uCC3E\uC558\uB2E4\uBA74, \uB371\uC744 \uC154\uD50C\uD55C\uB2E4.\r\n\u3010\uC790\uB3D9\u3011\u3010\uBC45\uAC00\uB4DC
      \uC11C\uD074\u3011 : \uC774 \uC720\uB2DB\uC774 \uC5B4\uD0DD\uD55C \uBC30\uD2C0
      \uC885\uB8CC\uC2DC, \uC790\uC2E0\uC758 \uC720\uB2DB\uC744 3\uC7A5 \uC120\uD0DD\uD55C\uB2E4.
      3\uC7A5 \uC120\uD0DD\uD588\uACE0, \uC120\uD0DD\uD55C \uC720\uB2DB \uC804\uBD80\uAC00
      \u300CFL\u2200MMe-G\u300D\uB97C \uD3EC\uD568\uD55C \uAC01\uAC01 \uB2E4\uB978
      \uC774\uB984\uC778 \uC720\uB2DB\uC774\uB77C\uBA74, \u3010\uCF54\uC2A4\uD2B8\u3011[\u3010\uCE74\uC6B4\uD130
      \uBE14\uB798\uC2A4\uD2B8\u3011(1)]\uD558\uB294 \uAC83\uC73C\uB85C, \uC790\uC2E0\uC758
      \uC18C\uC6B8\uC5D0\uC11C \u300CFL\u2200MMe-G \uBE14\uB8E8\uD074\uB808\uC5B4\u300D\uB97C
      1\uC7A5 \uC120\uD0DD\uD558\uACE0, \u3010\uC2A4\uD0E0\uB4DC\u3011\uB85C \uB77C\uC774\uB4DC\uD558\uACE0,
      \uADF8 \uD134 \uC911, \uADF8 \uC720\uB2DB\uC740, \uC790\uB3D9 \uB2A5\uB825
      \uC804\uBD80\uB97C \uC783\uACE0, \uC790\uC2E0\uACFC \uC0C1\uB300\uC758, \uB370\uBBF8\uC9C0\uC874
      \uD569\uACC4 1\uC7A5\uB2F9, \uD30C\uC6CC+2000. \uADF8 \uD134 \uC885\uB8CC\uC2DC,
      \uC790\uC2E0\uC758 \uC18C\uC6B8\uC774\uB098 \uB4DC\uB86D\uC5D0\uC11C \u300CFL\u2200MMe-G
      \uB85C\uC9C0\uC544\u300D\uB97C 1\uC7A5 \uC120\uD0DD\uD558\uACE0, \u3010\uB808\uC2A4\uD2B8\u3011\uB85C
      \uB77C\uC774\uB4DC\uD55C\uB2E4."
    availableRarities: 000000000100000003000000
