    tribeList: 10000000
    triggerType: 0
    cardType: 0
    flavorText: "\u300E\uB9CC\uD654\uC640 \uBE5B\uB0A0 \uC218 \uC788\uB294 \uB0B4\uC77C\uC744
      \uD5A5\uD574. \uBAA8\uB450\uAC00 \uAC78\uC744 \uC218 \uC788\uB3C4\uB85D.\u300F"
    effectText: "\u3010\uAE30\uB3D9\u3011\u3010\uBC45\uAC00\uB4DC \uC11C\uD074\u3011\u3010\uD1341\uD68C\u3011
      : \u3010\uCF54\uC2A4\uD2B8\u3011[\u3010\uCE74\uC6B4\uD130 \uBE14\uB798\uC2A4\uD2B8\u3011(1)]\uD558\uB294
      \uAC83\uC73C\uB85C, \uC790\uC2E0\uC758 \uC720\uB2DB\uC744 \uC6D0\uD558\uB294
      \uB9E4\uC218 \uC120\uD0DD\uD558\uACE0, \uC774\uD558\uB97C 1\uAC1C \uC2E4\uC2DC\uD55C\uB2E4.
      4\uC7A5 \uC120\uD0DD\uD588\uACE0, \uC120\uD0DD\uD55C \uC720\uB2DB \uC804\uBD80\uAC00
      \uAC01\uAC01 \uB2E4\uB978 \uC774\uB984\uC774\uB77C\uBA74, 1\uAC1C\uAC00 \uC544\uB2CC
      2\uAC1C \uC2E4\uC2DC\uD558\uACE0, 5\uC7A5 \uC774\uC0C1 \uC120\uD0DD\uD588\uACE0,
      \uC120\uD0DD\uD55C \uC720\uB2DB \uC804\uBD80\uAC00 \uAC01\uAC01 \uB2E4\uB978
      \uC774\uB984\uC774\uB77C\uBA74, 1\uAC1C\uAC00 \uC544\uB2CC \uC804\uBD80\uB97C
      \uC2E4\uC2DC\uD55C\uB2E4.\r\n\xB7 1\uC7A5 \uB4DC\uB85C\uC6B0\uD558\uACE0, \u3010\uC5D0\uB108\uC9C0
      \uCC28\uC9C0\u3011(3).\r\n\xB7 \uC790\uC2E0\uC758 \uC720\uB2DB\uC744 1\uC7A5
      \uC120\uD0DD\uD558\uACE0, \uADF8 \uD134 \uC911, \uD30C\uC6CC+15000.\r\n\xB7
      \uADF8 \uD134 \uC911, \uC774 \uC720\uB2DB\uC758 \uD06C\uB9AC\uD2F0\uCEEC+1.\r\n\u3010\uB514\uBC14\uC778
      \uC2A4\uD0AC\u3011\u3010\uC790\uB3D9\u3011\u3010\uBC45\uAC00\uB4DC \uC11C\uD074\u3011
      : \uC774 \uC720\uB2DB\uC774 \uADF8\uB808\uC774\uB4DC 3 \uC774\uC0C1\uC5D0 \uC5B4\uD0DD\uD55C
      \uBC30\uD2C0 \uC885\uB8CC\uC2DC, \u3010\uCF54\uC2A4\uD2B8\u3011[\uB9AC\uC5B4\uAC00\uB4DC
      \uC804\uBD80\uB97C \uD328\uC5D0 \uB418\uB3CC\uB9BC]\uC73C\uB85C, \uC790\uC2E0\uC758
      \uD328\uC5D0\uC11C \uC720\uB2DB \uCE74\uB4DC\uB97C 1\uC7A5\uAE4C\uC9C0 \uC120\uD0DD\uD558\uC5EC,
      \uB9AC\uC5B4\uAC00\uB4DC \uC11C\uD074\uC5D0 \uCF5C \uD558\uACE0, \uADF8 \uD134
      \uC911, \uADF8 \uC720\uB2DB\uC758 \uD30C\uC6CC\uC640 \uD06C\uB9AC\uD2F0\uCEEC\uC744,
      \uC774 \uC720\uB2DB\uACFC \uAC19\uC544\uC9C8\uB54C\uAE4C\uC9C0 \uC99D\uAC10\uC2DC\uD0A8\uB2E4.
      (\uB514\uBC14\uC778 \uC2A4\uD0AC\uC740 \uC790\uC2E0\uC758 \uB2E4\uB978 \uCE74\uB4DC\uB97C
      \uD3EC\uD568\uD558\uC5EC \uD30C\uC774\uD2B8 \uC911 \uD569\uACC4 1\uBC88\uB9CC
      \uC0AC\uC6A9\uD560 \uC218 \uC788\uB2E4.)"
