    cardName: "\uD50C\uB798\uC2DC\u30FB\uBE0C\uB7EC\uC2DC \uD50C\uB85C\uC824\uB9AC\uC544"
    grade: 3
    power: 13000
    shield: 0
    critical: 1
    maxCount: 4
    isSentinel: 0
    countryList: 05000000
    tribeList: 08000000
    triggerType: 0
    cardType: 0
    flavorText: "\u300E\uBB34\uC6B0. \uADF8\uB807\uAC8C \uCE6D\uCC2C\uD574\uBD24\uC790
      \uC544\uBB34\uAC83\uB3C4 \uC548 \uB098\uC640......!\u300F"
    effectText: "\u3010\uC601\uC18D\u3011\u3010\uBC45\uAC00\uB4DC \uC11C\uD074\u3011
      : \uC790\uC2E0\uC740, \u3010\uC601\uC18D\u3011, \u3010\uAE30\uB3D9\u3011, \u3010\uC790\uB3D9\u3011
      \uC5B4\uB290\uCABD\uC758 \uB2A5\uB825\uC744 \uAC00\uC9C4 \uC720\uB2DB \uCE74\uB4DC\uB97C
      \uCF5C\uD560 \uC218 \uC5C6\uB2E4. (\uAC00\uB514\uC5B8 \uC11C\uD074\uC5D0\uB3C4
      \uCF5C\uD560 \uC218 \uC5C6\uB2E4.)\n\u3010\uC601\uC18D\u3011\u3010\uBC45\uAC00\uB4DC
      \uC11C\uD074\u3011 : \uC790\uC2E0\uC758 \uAC00\uB514\uC5B8 \uC11C\uD074\uC758
      \uC720\uB2DB \uC804\uBD80\uC758 \uC2E4\uB4DC+5000. \uC774 \uD134\uC5D0 \uC790\uC2E0\uC774
      \uC624\uB354\uB97C \uD50C\uB808\uC774\uD588\uB2E4\uBA74, \uC790\uC2E0 \uC55E\uC5F4
      \uC720\uB2DB \uC804\uBD80\uC758 \uD30C\uC6CC+5000.\n\u3010\uAE30\uB3D9\u3011\u3010\uBC45\uAC00\uB4DC
      \uC11C\uD074\u3011\u3010\uD1341\uD68C\u3011 : \u3010\uCF54\uC2A4\uD2B8\u3011[\u3010\uC18C\uC6B8
      \uBE14\uB798\uC2A4\uD2B8\u3011(1), \u3010\uC5D0\uB108\uC9C0 \uBE14\uB798\uC2A4\uD2B8\u3011(2)]\uD558\uB294
      \uAC83\uC73C\uB85C, \uC790\uC2E0\uC758 \uB371\uC744 \uC704\uC5D0\uC11C 7\uC7A5
      \uBCF4\uACE0, \uC720\uB2DB \uCE74\uB4DC\uB97C 2\uC7A5\uAE4C\uC9C0 \uC120\uD0DD\uD558\uC5EC,
      \uB9AC\uC5B4\uAC00\uB4DC \uC11C\uD074\uC5D0 \uCF5C\uD558\uACE0, \uB2E4\uC2DC
      \uC624\uB354 \uCE74\uB4DC\uB97C 1\uC7A5\uAE4C\uC9C0 \uC120\uD0DD\uD558\uACE0,
      \uACF5\uAC1C\uD558\uC5EC \uD328\uC5D0 \uCD94\uAC00\uD558\uACE0, \uB371\uC744
      \uC154\uD50C\uD55C\uB2E4.\n\u3010\uC790\uB3D9\u3011\u3010\uBC45\uAC00\uB4DC
      \uC11C\uD074\u3011 : \uC774 \uC720\uB2DB\uC774 \uC5B4\uD0DD\uD588\uC744 \uB54C,
      \u3010\uCF54\uC2A4\uD2B8\u3011[\u3010\uCE74\uC6B4\uD130 \uBE14\uB798\uC2A4\uD2B8\u3011(1)]\uD558\uB294
      \uAC83\uC73C\uB85C, \uC790\uC2E0\uC758 \uB9AC\uC5B4\uAC00\uB4DC\uB97C 1\uC7A5
      \uC120\uD0DD\uD558\uC5EC, \u3010\uC2A4\uD0E0\uB4DC\u3011\uC2DC\uD0A8\uB2E4.
      \uC790\uC2E0 \uB4DC\uB86D\uC758 \uC624\uB354 \uCE74\uB4DC\uAC00 5\uC885\uB958
      \uC774\uC0C1\uC774\uB77C\uBA74, 1\uC7A5\uC774 \uC544\uB2CC 2\uC7A5 \uC120\uD0DD\uD55C\uB2E4."
    availableRarities: 00000000
    spriteAssetKeys:
    - card_63000146
  - id: 63000147
