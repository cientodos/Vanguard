  - id: 63000131
    cardName: "\uB9CC\uD654\uC758 \uC6B4\uBA85\uC790 \uD06C\uB9AC\uC2A4\uB808\uC778\u30FB\uCE74\uB374\uCC28"
    grade: 3
    power: 13000
    shield: 0
    critical: 1
    maxCount: 4
    isSentinel: 0
    countryList: 05000000
    tribeList: 10000000
    triggerType: 0
    cardType: 0
    flavorText: "\u300E\uB9CC\uD654\uB85C \uBC18\uC9DD\uC774\uB294 \uBB34\uB300\uB97C,
      \uBAA8\uB450 \uD568\uAED8 \uB9CC\uB4E4\uC5B4\uB0C5\uC2DC\uB2E4.\u300F"
    effectText: "\u3010\uAE30\uB3D9\u3011\u3010\uBC45\uAC00\uB4DC \uC11C\uD074\u3011\u3010\uD1341\uD68C\u3011
      : \u3010\uCF54\uC2A4\uD2B8\u3011[\u3010\uCE74\uC6B4\uD130 \uBE14\uB798\uC2A4\uD2B8\u3011(1)]\uD558\uB294
      \uAC83\uC73C\uB85C, \uB2F9\uC2E0\uC758 \uC720\uB2DB\uC744 \uC6D0\uD558\uB294
      \uB9E4\uC218 \uC120\uD0DD\uD558\uACE0, \uC774\uD558\uB97C 1\uAC1C \uC2E4\uC2DC\uD55C\uB2E4.
      4\uC7A5 \uC120\uD0DD\uD588\uACE0, \uC120\uD0DD\uD55C \uC720\uB2DB \uC804\uBD80\uAC00
      \uAC01\uAC01 \uB2E4\uB978 \uC774\uB984\uC774\uB77C\uBA74, 1\uAC1C\uAC00 \uC544\uB2CC
      2\uAC1C \uC2E4\uC2DC\uD55C\uB2E4. 5\uC7A5 \uC774\uC0C1 \uC120\uD0DD\uD588\uACE0,
      \uC120\uD0DD\uD55C \uC720\uB2DB \uC804\uBD80\uAC00 \uAC01\uAC01 \uB2E4\uB978
      \uC774\uB984\uC774\uB77C\uBA74, 1\uAC1C\uAC00 \uC544\uB2CC \uC804\uBD80 \uC2E4\uC2DC\uD78C\uB2E4.\n\xB7
      1\uC7A5 \uB4DC\uB85C\uC6B0\uD558\uACE0, \u3010\uC5D0\uB108\uC9C0 \uCC28\uC9C0\u3011(3).\n\xB7
      \uB2F9\uC2E0\uC758 \uC720\uB2DB\uC744 1\uC7A5 \uC120\uD0DD\uD558\uACE0, \uADF8
      \uD134 \uC911, \uD30C\uC6CC+15000.\n\xB7 \uADF8 \uD134 \uC911, \uC774 \uC720\uB2DB\uC758
      \uD06C\uB9AC\uD2F0\uCEEC+1.\n\xB7 \uB2F9\uC2E0\uC758 \uB9AC\uC5B4\uAC00\uB4DC\uB97C
      1\uC7A5 \uC120\uD0DD\uD558\uACE0, \uADF8 \uD134 \uC911, \u300E\u3010\uC790\uB3D9\u3011\u3010\uB9AC\uC5B4\uAC00\uB4DC
      \uC11C\uD074\u3011 : \uB2F9\uC2E0\uC758 \uD134 \uC885\uB8CC \uC2DC, \uC774
      \uC720\uB2DB\uC744 \uD328\uC5D0 \uB418\uB3CC\uB824\uB3C4 \uB41C\uB2E4.\u300F\uB97C
      \uBD80\uC5EC\uD55C\uB2E4.\n\u3010\uB514\uBC14\uC778 \uC2A4\uD0AC\u3011 - \u3010\uC790\uB3D9\u3011\u3010\uBC45\uAC00\uB4DC
      \uC11C\uD074\u3011 : \uC774 \uC720\uB2DB\uC774 \uADF8\uB808\uC774\uB4DC 3 \uC774\uC0C1\uC5D0
      \uC5B4\uD0DD \uD55C \uBC30\uD2C0 \uC885\uB8CC \uC2DC, \u3010\uCF54\uC2A4\uD2B8\u3011[\u3010\uC18C\uC6B8
      \uBE14\uB798\uC2A4\uD2B8\u3011(1)]\uD558\uB294 \uAC83\uC73C\uB85C, \uB2F9\uC2E0\uC758
      \uB9AC\uC5B4\uAC00\uB4DC\uB97C \uC6D0\uD558\uB294 \uB9E4\uC218 \uC120\uD0DD\uD558\uACE0,
      \uD328\uC5D0 \uB418\uB3CC\uB9AC\uACE0, \uB2F9\uC2E0\uC758 \uD328\uC5D0\uC11C
      \uC720\uB2DB \uCE74\uB4DC\uB97C 1\uC7A5\uAE4C\uC9C0 \uC120\uD0DD\uD558\uC5EC,
      \uB9AC\uC5B4\uAC00\uB4DC \uC11C\uD074\uC5D0 \uCF5C\uD558\uACE0, \uADF8 \uD134
      \uC911, \uADF8 \uC720\uB2DB\uC758 \uD30C\uC6CC\uC640 \uD06C\uB9AC\uD2F0\uCEEC\uC744,
      \uC774 \uC720\uB2DB\uACFC \uAC19\uC544\uC9C8\uB54C\uAE4C\uC9C0 \uC99D\uAC10\uC2DC\uD0A8\uB2E4."
    availableRarities: 00000000010000000200000003000000
