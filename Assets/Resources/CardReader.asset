  - id: 63000101
    cardName: "\uACE0\uB974\uACE4\u30FB\uAE30\uD504\uD2B8 \uC2DC\uC544\uB098"
    grade: 3
    power: 13000
    shield: 0
    critical: 1
    maxCount: 4
    isSentinel: 0
    countryList: 05000000
    tribeList: 04000000
    triggerType: 0
    cardType: 0
    flavorText: "\u300E\uC640~! \uC774\uB807\uAC8C \uADC0\uC5EC\uC6B4 \uAC78 \uBC1B\uC744
      \uC218 \uC788\uB2E4\uBA74, \uB2F9\uC5F0\uD788 \uAE30\uC058\uC9C0~.\u300F"
    effectText: "\uB4DC\uB808\uC2A4\uC5C5 - \u300C\uACE0\uB974\uACE4 \uC544\uC774\uC988
      \uC2DC\uC544\uB098\u300D\r\n\u3010\uC790\uB3D9\u3011 : \uC774 \uC720\uB2DB\uC774
      \u300C\uACE0\uB974\uACE4 \uC544\uC774\uC988 \uC2DC\uC544\uB098\u300D\uC5D0
      \uB77C\uC774\uB4DC\uD574\uC11C \uB4F1\uC7A5\uD588\uC744\uB54C, \uB2F9\uC2E0\uC758
      \uB371\uC744 \uC704\uC5D0\uC11C 5\uC7A5 \uBCF4\uACE0, 1\uC7A5\uAE4C\uC9C0 \uC120\uD0DD\uD558\uACE0,
      \uACF5\uAC1C\uD558\uC5EC, \uADF8\uAC83\uC774 \uC218\uD638\uC790\uB97C \uAC16\uACE0
      \uC788\uC9C0 \uC54A\uC740 \uB178\uBA40 \uC720\uB2DB\uC774\uB77C\uBA74 \uB9AC\uC5B4\uAC00\uB4DC
      \uC11C\uD074\uC5D0 \uCF5C\uD558\uACE0, \uBE14\uB9AC\uCE20 \uC624\uB354\uB77C\uBA74
      \uD328\uC5D0 \uCD94\uAC00\uD55C\uB2E4. \uB371\uC744 \uC154\uD50C\uD55C\uB2E4.\r\n\u3010\uC601\uC18D\u3011\u3010\uBC45\uAC00\uB4DC
      \uC11C\uD074\u3011 : \uC0C1\uB300\uC758, \uC55E\uC5F4\uACFC \uB9AC\uC5B4\uAC00\uB4DC
      \uC11C\uD074\uACFC \uAC00\uB514\uC5B8 \uC11C\uD074\uC758 \uC720\uB2DB\uC774
      \uD569\uACC4 2\uC7A5 \uC774\uD558\uB77C\uBA74, \uC774 \uC720\uB2DB\uC758 \uD06C\uB9AC\uD2F0\uCEEC+1/\uB4DC\uB77C\uC774\uBE0C+1.\r\n\u3010\uC790\uB3D9\u3011\u3010\uBC45\uAC00\uB4DC
      \uC11C\uD074\u3011 : \uB2F9\uC2E0\uC758 \uD134 \uC885\uB8CC\uC2DC, \uB2F9\uC2E0\uC758
      \uC18C\uC6B8\uC5D0\uC11C \uC6D0\uB798 \uCE74\uB4DC \uC774\uB984\uC774 \u300C\uACE0\uB974\uACE4
      \uC544\uC774\uC988 \uC2DC\uC544\uB098\u300D\uC778 \uCE74\uB4DC\uB97C 1\uC7A5
      \uC120\uD0DD\uD558\uACE0, \u3010\uB808\uC2A4\uD2B8\u3011\uB85C \uB77C\uC774\uB4DC\uD55C\uB2E4."
    availableRarities: 00000000010000000200000003000000
