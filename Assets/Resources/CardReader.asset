    countryList: 05000000
    tribeList: 10000000
    triggerType: 0
    cardType: 0
    flavorText: "\u300E\uC794\uC794\uD55C \uBC14\uB2E4\uC5D0\uC11C, \uC61B \uC804\uC124\uC744
      \uB5A0\uC62C\uB9AC\uBA70.\u300F"
    effectText: "\u3010\uC790\uB3D9\u3011 : \uC774 \uC720\uB2DB\uC774 \uB9AC\uC5B4\uAC00\uB4DC
      \uC11C\uD074\uC5D0 \uB4F1\uC7A5\uD588\uC744 \uB54C, \u3010\uCF54\uC2A4\uD2B8\u3011[\u3010\uC5D0\uB108\uC9C0
      \uBE14\uB798\uC2A4\uD2B8\u3011(3)]\uD558\uB294 \uAC83\uC73C\uB85C, \uB2F9\uC2E0\uC758
      \uB371\uC744 \uC704\uC5D0\uC11C 7\uC7A5 \uBCF4\uACE0, \u300C\uD37C\uC2DC\uD53C\uCE74\u300D\uB97C
      \uD3EC\uD568\uD55C \uADF8\uB808\uC774\uB4DC 3\uC744 1\uC7A5\uAE4C\uC9C0 \uC120\uD0DD\uD558\uACE0,
      \uACF5\uAC1C\uD558\uC5EC \uD328\uC5D0 \uCD94\uAC00\uD558\uACE0, \uB371\uC744
      \uC154\uD50C\uD55C\uB2E4.\r\n\u3010\uC790\uB3D9\u3011\u3010\uB9AC\uC5B4\uAC00\uB4DC
      \uC11C\uD074\u3011\u3010\uD1341\uD68C\u3011 : \uC774 \uC720\uB2DB\uC774 \uC5B4\uD0DD\uD588\uC744
      \uB54C, \u3010\uCF54\uC2A4\uD2B8\u3011[\uB4DC\uB86D\uC5D0\uC11C \u300C\uD37C\uC2DC\uD53C\uCE74\u300D\uB97C
      \uD3EC\uD568\uD55C \uADF8\uB808\uC774\uB4DC 3\uC744 1\uC7A5 \uB371 \uC544\uB798\uC5D0
      \uB193\uC74C]\uC73C\uB85C, \uADF8 \uBC30\uD2C0 \uC911, \uC774 \uC720\uB2DB\uC758
      \uD30C\uC6CC+10000."
