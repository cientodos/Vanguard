  - id: 63000061
    cardName: "\uC5D4\uB4E4\uB9C1\u30FB\uBDF0\uD2F0 \uC5D0\uB974\uBBF8\uB2C8\uC544"
    grade: 3
    power: 13000
    shield: 0
    critical: 1
    maxCount: 4
    isSentinel: 0
    countryList: 05000000
    tribeList: 01000000
    triggerType: 0
    cardType: 0
    flavorText: "\u300E\uCEE8\uC149\uC740 \u300C\uC369\uC9C0 \uC54A\uACE0 \uB418\uC0B4\uC544\uB098\uB2E4\u300D\uC57C.\u300F"
    effectText: "\uB4DC\uB808\uC2A4\uC5C5 - \u300C\uCEE4\uBC0D \uBDF0\uD2F0 \uC5D0\uB974\uBBF8\uB2C8\uC544\u300D
      (\uD30C\uC774\uD2B8 \uC911, \uC9C0\uC815 \uCE74\uB4DC\uC640 \uAC19\uC740 \uC774\uB984\uC73C\uB85C\uB3C4
      \uCDE8\uAE09\uD55C\uB2E4)\r\n\u3010\uC601\uC18D\u3011\u3010\uBC45\uAC00\uB4DC
      \uC11C\uD074\u3011 : \uC790\uC2E0\uC758 \uBC30\uD2C0 \uD398\uC774\uC988 \uC911,
      \uC790\uC2E0\uC758 \uB4B7\uBA74\uC778 \uB370\uBBF8\uC9C0\uC874\uC774 3\uC7A5
      \uC774\uC0C1\uC774\uB77C\uBA74, \uC790\uC2E0 \uC55E\uC5F4\uC758 \uC804\uB825
      \uB2A5\uB825\uC744 \uAC00\uC9C4 \uC720\uB2DB \uC804\uBD80\uC758 \uC790\uB3D9
      \uB2A5\uB825\uC758 \uCF54\uC2A4\uD2B8\uB294 \u3010\uCE74\uC6B4\uD130 \uBE14\uB798\uC2A4\uD2B8\u3011(1)
      \uAC10\uC18C\uD55C\uB2E4.\r\n\uC804\uB825 - \u3010\uC790\uB3D9\u3011\u3010\uBC45\uAC00\uB4DC
      \uC11C\uD074\u3011 : \uC774 \uD134\uC5D0 \uC790\uC2E0\uC774 \uD398\uB974\uC18C\uB098
      \uB77C\uC774\uB4DC\uD558\uACE0 \uC788\uB2E4\uBA74, \uC774 \uCF54\uC2A4\uD2B8\uB294
      \u300E\u3010\uCE74\uC6B4\uD130 \uBE14\uB798\uC2A4\uD2B8\u3011(1)\u300F\uB85C\uB3C4
      \uC9C0\uBD88\uD560 \uC218 \uC788\uB2E4. \uC774 \uC720\uB2DB\uC774 \uC5B4\uD0DD\uD55C
      \uBC30\uD2C0 \uC885\uB8CC\uC2DC, \uC790\uC2E0\uC758 \uC18C\uC6B8\uC774 0\uC7A5\uC774\uB77C\uBA74,
      \u3010\uCF54\uC2A4\uD2B8\u3011[\uD328\uC5D0\uC11C \u300C\uC5D0\uB974\uBBF8\uB2C8\uC544\u300D\uB97C
      \uD3EC\uD568\uD55C \uCE74\uB4DC\uB97C 1\uC7A5 \uBC84\uB9BC]\uC73C\uB85C, \uC790\uC2E0
      \uC55E\uC5F4\uC758 \uC804\uB825 \uB2A5\uB825\uC744 \uAC00\uC9C4 \uB9AC\uC5B4\uAC00\uB4DC
      \uC804\uBD80\uB97C \u3010\uC2A4\uD0E0\uB4DC\u3011\uC2DC\uD0A8\uB2E4."
