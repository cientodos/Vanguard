      4\uC7A5 \uC774\uC0C1\uC774\uB77C\uBA74, \uC774 \uC720\uB2DB\uC758 \uD30C\uC6CC+10000/\uC2E4\uB4DC+10000.
      (\uC0C1\uB300 \uD134\uC5D0\uB3C4 \uC720\uD6A8)"
    availableRarities: 00000000
    spriteAssetKeys:
