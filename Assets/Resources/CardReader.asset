      \uCE74\uB4DC \uC911\uC5D0\uC11C 1\uC7A5\uAE4C\uC9C0 \uC120\uD0DD\uD558\uC5EC,
      \uB9AC\uC5B4\uAC00\uB4DC \uC11C\uD074\uC5D0 \uCF5C\uD558\uACE0, \uADF8 \uD134
      \uC911, \uD30C\uC6CC+10000. \u300C\uC11C\uB85C \uC5F0\uACB0\uD558\uB294 \uCE5C\uAD50\uC758
      \uACE0\uB9AC \uD398\uD2B8\uB77C\uB974\uCE74\u300D\uB97C \uC120\uD0DD\uD588\uB2E4\uBA74,
