      \uD3EC\uD568\uD55C \uADF8\uB808\uC774\uB4DC 3 \uC774\uC0C1\uC774\uACE0, \uB2F9\uC2E0\uC758
      \uBC14\uC778\uB4DC\uC874\uC5D0 \uD601\uC6D4 \uCE74\uB4DC\uAC00 4\uC7A5 \uC774\uC0C1\uC774\uB77C\uBA74,
      \uC774 \uC720\uB2DB\uC740 \uB4B7\uC5F4\uC5D0\uC11C\uB3C4 \uC5B4\uD0DD\uD560
      \uC218 \uC788\uB2E4.\n\u3010\uC790\uB3D9\u3011\u3010\uC911\uC559\uB4B7\uC5F4\uC758
      \uB9AC\uC5B4\uAC00\uB4DC \uC11C\uD074\u3011 : \uC774 \uC720\uB2DB\uC774 \uC5B4\uD0DD\uD588\uC744\uB54C,
      \uB2F9\uC2E0\uC758 \uBC45\uAC00\uB4DC\uAC00 \u300C\uC778\uBC1C\uB514\uC624\u300D\uB97C
      \uD3EC\uD568\uD55C \uADF8\uB808\uC774\uB4DC 3 \uC774\uC0C1\uC774\uB77C\uBA74,
      \u3010\uCF54\uC2A4\uD2B8\u3011[\uD328\uC5D0\uC11C 1\uC7A5 \uBC84\uB9BC]\uC73C\uB85C,
