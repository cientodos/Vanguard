    countryList: 05000000
    tribeList: 05000000
    triggerType: 0
    cardType: 0
    flavorText: "\u300E\uD558\uB098\uD558\uB098\uAC00 \uC18C\uC911\uD55C \uC778\uC5F0\uC774\uB2C8\uAE4C,
